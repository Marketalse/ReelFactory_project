# Media and heavy files stay on the Mac, never in git
*.mov
*.MOV
*.mp4
*.m4a
*.wav
*.mp3
*.png
*.jpg
*.jpeg
!templates/**/*.png
!style/**/*.png
inbox/*
!inbox/.gitkeep
!inbox/BRIEF_TEMPLATE.md
jobs/*
!jobs/.gitkeep
library/*
!library/.gitkeep
references/own/*
!references/own/.gitkeep
!references/own/*.md
assets/raw/
# Tooling, caches, secrets
node_modules/
__pycache__/
*.pyc
.venv*/
.DS_Store
.env
*.key
auth.json
dashboard/.backups/
dashboard/expenses.json
dashboard/server.log

# Upload page: background run output, other video types
dashboard/.runs/
*.avi
*.webm
*.mkv
*.m4v
!library/broll/
library/broll/*
!library/broll/README.md

# 20,000+ bulk-checked icons and reports (made by scripts/asset_batch.py; local only)
library/assets/ok/
library/assets/_reports/
