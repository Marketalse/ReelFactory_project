{
  "_note": "Rhythm and validator limits. The validator and the Director prompt both read this file.",
  "reel_length_s": {
    "min": 40,
    "max": 90
  },
  "hook": {
    "max_s": 3.0,
    "visible_at_0": true
  },
  "max_still_hold_s": 3.5,
  "min_beat_s": 0.8,
  "chapter_card_every_s": [
    15,
    20
  ],
  "cut": {
    "remove_pauses_over_s": 0.35,
    "retakes": "last_take_wins"
  },
  "moments": {
    "flash": {
      "max_per_reel": 2,
      "only_on": "payoff or spoken number"
    },
    "punch_in": {
      "min_gap_s": 3
    },
    "name_tag": {
      "min_gap_s": 6
    },
    "text_card": {
      "min_gap_s": 10
    },
    "logo_card": {
      "requires": "file in job assets/"
    },
    "counter": {
      "requires": "number actually spoken"
    },
    "info_card": {
      "min_gap_s": 6
    },
    "number_graph": {
      "min_gap_s": 8
    },
    "before_after": {
      "min_gap_s": 8
    },
    "tier_list": {
      "min_gap_s": 10
    }
  },
  "sfx": {
    "pop_min_gap_s": 3
  },
  "captions": {
    "max_words": 3,
    "safe_zone_px": {
      "top": 250,
      "bottom": 420,
      "left": 108,
      "right": 160
    }
  },
  "cta": {
    "last_beat_only": true,
    "handle_on_cta_only": true
  },
  "safe_zone": {
    "_note": "Hesham's design rule (2026-11-01, style/SAFE_ZONES.md): the stricter of Instagram Reels and TikTok. Every text, card and key visual rests inside this box on a 1080x1920 canvas.",
    "canvas": [
      1080,
      1920
    ],
    "top": 250,
    "bottom": 420,
    "left": 108,
    "right": 160,
    "text_max_width": 780,
    "text_x": 124,
    "captions_y": [
      1200,
      1450
    ],
    "feed_square_y": [
      420,
      1500
    ],
    "never_below_y": 1500
  }
}