  "_status": "DRAFT 2026-11-01. Items marked CONFIRM need Hesham's answer.",
  "colors": {
    "bg": "#242834",
    "accent": "#B6FF00",
    "secondary": "#7D53FF",
    "negative": "#FF6B4A",
    "text": "#FFFFFF",
    "surface": "#2E3342",
    "muted": "#CDD2E0"
  },
  "font": {
    "family": "Readex Pro",
    "file": "style/fonts/ReadexPro[HEXP,wght].ttf",
