    "show_handle": "cta_card_only",
    "platform_variants": {
      "instagram": {
        "line": "CONFIRM — e.g. إذا عجبك المحتوى احفظ الفيديو وتابعني",
        "promise": "CONFIRM — e.g. كل يوم شي جديد بالتسويق والبزنس"
      },
      "tiktok": {
        "line": "CONFIRM — e.g. إذا مهتم بهالمحتوى تابعني",
        "promise": "CONFIRM — e.g. حتى يوصلك الجزء الجاي"
      }
    },
    "comment_keyword": {
      "used_only_when": "the reel offers something to send by DM",
      "set_per_job": true,
      "example": {
        "word": "متجر",
        "line": "علقلي متجر",
        "promise": "وأرسل لك كيف تثبت خدمة زبائن احترافية لمتجرك"
      }
    }
  },
  "audio": {
    "voice_target_lufs": -14,
    "music": {
      "enabled": true,
      "level_under_voice_db": -20,
      "duck_while_speaking": true,
      "source": "CONFIRM licensed library"
    },
    "sfx": {
      "enabled": true,
      "source": "CONFIRM licensed library",
      "whoosh": "layout change",
      "pop": "keyword (max 1 per 3 s)",
      "ding": "spoken number / counter"
    }
  },
  "references": {
    "main": "references/ref5_B_counters.mp4",
    "layout": "references/ref3_B_split.mp4"
